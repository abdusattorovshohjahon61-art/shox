# ===== Asosiy =====
# Saytning ochiq manzili (to'lovdan qaytish va Replicate webhook uchun). https bo'lishi kerak.
APP_URL=https://shox.uz
# Admin panelga kira oladigan emaillar (vergul bilan)
ADMIN_EMAILS=siz@gmail.com
# Ro'yxatdan o'tganda beriladigan bepul kredit
FREE_CREDITS=50

# ===== Ma'lumotlar bazasi =====
# VPS/Docker: fayl (standart). Vercel: Turso — libsql://<db>.turso.io + token
DATABASE_URL=file:./data/shox.db
DATABASE_AUTH_TOKEN=

# ===== AI video (Replicate) =====
# https://replicate.com/account/api-tokens — bo'sh bo'lsa DEMO rejim
REPLICATE_API_TOKEN=
# curl -H "Authorization: Bearer $REPLICATE_API_TOKEN" https://api.replicate.com/v1/webhooks/default/secret
REPLICATE_WEBHOOK_SECRET=

# ===== Limitlar =====
MAX_JOBS_PER_HOUR=20
MAX_CONCURRENT_JOBS=3

# ===== Video saqlash (Cloudflare R2 / S3) — ishlab chiqarishda zarur =====
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=shox-videos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Bucket'ning ochiq manzili (R2: Public bucket yoki o'z domeningiz)
S3_PUBLIC_URL=https://videos.shox.uz
S3_REGION=auto

# ===== Click (https://merchant.click.uz) =====
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# ===== Payme (https://merchant.payme.uz) =====
PAYME_MERCHANT_ID=
PAYME_KEY=
# Sinov kassasi uchun true
PAYME_TEST=false

# Sinov to'lovi tugmasi (haqiqiy pul yechilmaydi). Ishlab chiqarishda YOQMANG.
ENABLE_TEST_PAYMENTS=false
