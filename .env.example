# @BotFather dan olingan token
BOT_TOKEN=123456:ABC-DEF...
# Admin(lar)ning Telegram ID raqamlari, vergul bilan ajratiladi
ADMIN_IDS=111111111,222222222
# Ma'lumotlar bazasi fayli
DB_PATH=shop.db

# Do'kon ma'lumotlari
SHOP_NAME=Shox Do'kon
SHOP_PHONE=+998 90 123 45 67
SHOP_ADDRESS=Toshkent sh., Chilonzor tumani
SHOP_HOURS=Har kuni 09:00 - 21:00

# Ish vaqti (bo'sh qoldirilsa, 24/7 hisoblanadi)
OPEN_TIME=09:00
CLOSE_TIME=21:00
TIMEZONE=Asia/Tashkent

# Kunlik hisobot adminlarga shu vaqtda yuboriladi (bo'sh = yuborilmaydi)
REPORT_TIME=21:30

# Karta orqali to'lov: @BotFather -> /mybots -> Payments -> Click yoki Payme
# Bo'sh qoldirilsa, faqat naqd to'lov bo'ladi
PAYMENT_PROVIDER_TOKEN=

# Olib ketish (samovivoz) imkoniyati: 1 - yoqilgan, 0 - o'chirilgan
PICKUP_ENABLED=1
